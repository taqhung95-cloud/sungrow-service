function xbmCaseJournal_(m,g){return xbmExistingJournal_(m,g)||DriveApp.getFolderById(m.folderId).createFile('case-'+g.sourceCase+'.json',JSON.stringify({state:'PREPARED',migrationId:m.id,group:g}),'application/json');}
