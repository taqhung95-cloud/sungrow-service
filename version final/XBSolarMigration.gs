function xbmProtect_(m){var meta=xbmGet_('?fields=sheets(properties(sheetId,title),protectedRanges(protectedRangeId,description))'),description='XBSolar migration '+m.id,requests=[],ids=[];Object.keys(XBSolarMigrationPlan.keys).forEach(function(t){var s=meta.sheets.find(function(s){return s.properties.title===t;});if(!s)throw Error('Thiếu tab bảo vệ');var own=(s.protectedRanges||[]).filter(function(p){return p.description===description;});own.forEach(function(p){ids.push(p.protectedRangeId);});if(!own.length)requests.push({addProtectedRange:{protectedRange:{range:{sheetId:s.properties.sheetId},description:description,warningOnly:false,editors:{users:[m.actor]}}}});});if(requests.length){var result=xbmBatch_(requests);(result.replies||[]).forEach(function(r){if(r.addProtectedRange)ids.push(r.addProtectedRange.protectedRange.protectedRangeId);});}m.protectedRanges=ids;}
function xbmUnprotect_(m){var meta=xbmGet_('?fields=sheets(properties(title),protectedRanges(protectedRangeId,description))'),requests=[],owned=m.protectedRanges||[];meta.sheets.filter(function(s){return !!XBSolarMigrationPlan.keys[s.properties.title];}).forEach(function(s){(s.protectedRanges||[]).filter(function(p){return owned.indexOf(p.protectedRangeId)>=0;}).forEach(function(p){if(p.description!=='XBSolar migration '+m.id)throw Error('Bảo vệ của migration đã bị đổi; không xóa cấu hình khác.');requests.push({deleteProtectedRange:{protectedRangeId:p.protectedRangeId}});});});if(requests.length)xbmBatch_(requests);}
